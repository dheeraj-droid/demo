# Google AI Studio API key — https://aistudio.google.com/app/apikey
# If left blank, the bot falls back to a lightweight local parser.
GEMINI_API_KEY=

# Default dark-store coordinates (Bangalore city center). Prices/availability
# are localized, so this GPS position is injected into the scraping browser.
DEFAULT_LAT=12.9716
DEFAULT_LNG=77.5946

# Scraper options.
# HEADLESS=false shows the browser window (useful for debugging selectors).
HEADLESS=true
# Per-navigation timeout in milliseconds.
SCRAPE_TIMEOUT=20000

# Optional: path to a system Chromium. The Docker image sets this to
# /usr/bin/chromium automatically; leave blank for local dev.
PUPPETEER_EXECUTABLE_PATH=

# Optional: residential proxy for the SCRAPER ONLY (needed on VPS/datacenter IPs
# where Blinkit/Zepto block requests). WhatsApp traffic does NOT use this.
#   PROXY_SERVER=http://host:port
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
