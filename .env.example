# --- Scraper / browser ---
# HEADLESS=false shows the browser window (useful for debugging selectors).
HEADLESS=true
# Per-navigation timeout in milliseconds.
SCRAPE_TIMEOUT=25000

# Optional: path to a system Chromium. The Docker image sets this to
# /usr/bin/chromium automatically; leave blank for local dev.
PUPPETEER_EXECUTABLE_PATH=

# Optional: residential proxy for the SCRAPER ONLY (needed on VPS/datacenter IPs
# where Amazon serves a robot-check). WhatsApp traffic does NOT use this.
#   PROXY_SERVER=http://host:port
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Tracking ---
# How often to re-check prices (cron). Default: every 3 hours.
CHECK_CRON=0 */3 * * *
# Where tracked products + price history are stored.
DATA_FILE=./data/trackers.json
# Max price-history points kept per product.
MAX_HISTORY=200
